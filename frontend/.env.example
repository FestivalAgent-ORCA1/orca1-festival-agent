# mock: 예시 축제와 브라우저 찜 / api: 팀 서버 데이터와 로그인 계정의 찜
VITE_DATA_MODE=mock
# /api를 붙이지 않은 백엔드 주소. 키나 비밀번호를 VITE_ 변수에 넣지 마세요.
VITE_API_BASE_URL=http://localhost:8000
# 카카오맵 JavaScript 키 (FE2 일정 지도). 브라우저에 공개되는 키이므로 카카오 콘솔에서 허용 도메인을 꼭 등록하세요.
# 비워 두면 지도 대신 방문 순서 그림을 보여줍니다. REST API 키(백엔드용)를 넣지 마세요.
VITE_KAKAO_MAP_KEY=
