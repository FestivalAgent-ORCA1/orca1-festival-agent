# backend/.env 로 복사해서 값을 채운다. .env는 깃에 올리지 않는다.

# DB (Aiven) — 형식: mysql+pymysql://계정:비밀번호@호스트:포트/festival_dev?charset=utf8mb4
DATABASE_URL=
# Aiven 인증서. 로컬: certs/ca.pem / Render: /etc/secrets/ca.pem
DB_SSL_CA=

# 로그인 토큰 서명 키. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 프론트 주소 (쉼표로 여러 개)
CORS_ORIGINS=http://localhost:5173
# 자동 실행 작업. 공용 DB라서 한 곳(배포 서버)에서만 true
ENABLE_SCHEDULER=false

# 외부 API
TOURAPI_SERVICE_KEY=
KAKAO_REST_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
